              "path": ["api", "mobile", "support", "help-categories"]
            },
            "description": "Returns a sorted list of unique categories that have published articles. Useful to populate a category filter in the app."
          },
          "response": []
        },
        {
          "name": "Search Help Articles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mobile/support/help-center?search=book",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "support", "help-center"],
              "query": [
                { "key": "search", "value": "book" }
              ]
            },
            "description": "Search help articles by keyword in title, content, or category."
          },
          "response": []
        }
      ]
    },
