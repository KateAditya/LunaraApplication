<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Enable proxy functionality -->
    <rewrite>
      <rules>
        <!-- Redirect HTTP to HTTPS (optional - uncomment if needed) -->
        <!-- <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="https://{HTTP_HOST}{REQUEST_URI}" />
        </rule> -->

        <!-- Reverse proxy to Node.js application running on localhost:9076 -->
        <rule name="ReverseProxyRule" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:9076/{R:1}" />
        </rule>
      </rules>

      <!-- Set reverse proxy settings -->
      <outboundRules>
        <!-- Remove server header for security -->
        <rule name="Remove Server Header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="IIS" />
        </rule>

        <!-- Rewrite location header to match external URL -->
        <rule name="Rewrite Location Header">
          <match serverVariable="RESPONSE_Location" pattern="^http://localhost:9076/(.*)$" />
          <action type="Rewrite" value="http://103.224.247.35:9076/{R:1}" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- URL Rewrite module -->
    <httpModules>
      <add name="ApplicationInsightsWebServerModule" type="Microsoft.ApplicationInsights.Extensibility.IIS.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
    </httpModules>

    <!-- Default documents -->
    <defaultDocument>
      <files>
        <clear />
        <add value="server.js" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- MIME types -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>

    <!-- Compression -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="9" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- Enable dynamic compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Logging -->
    <logging>
      <centralLogFileFormat>
        <add name="ServerIP" />
        <add name="ClientIP" />
        <add name="Method" />
        <add name="URIStem" />
        <add name="URIQuery" />
        <add name="HttpStatus" />
        <add name="HttpSubStatus" />
        <add name="Win32Status" />
        <add name="TimeTaken" />
        <add name="SiteName" />
        <add name="ComputerName" />
        <add name="ServerPort" />
        <add name="UserName" />
        <add name="Cookie" />
        <add name="Referer" />
        <add name="UserAgent" />
        <add name="ProtocolVersion" />
        <add name="Host" />
        <add name="HttpReason" />
      </centralLogFileFormat>
    </logging>

    <!-- Custom headers for CORS (if needed for frontend access) -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="http://103.224.247.35:9075" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
        <add name="Access-Control-Allow-Credentials" value="true" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Application pool settings -->
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="node_modules" />
            <add segment="logs" />
            <add segment="uploads" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </system.webServer>

  <!-- Application settings -->
  <appSettings>
    <add key="NODE_ENV" value="production" />
    <add key="PORT" value="9076" />
  </appSettings>
</configuration>
