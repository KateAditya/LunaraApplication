# Environment
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=localhost

# Database Configuration (PostgreSQL)
DB_HOST=103.224.247.22
DB_PORT=5432
DB_NAME=lunara_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=10
DB_POOL_MAX=60
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Escrow Account Configuration
ESCROW_ACCOUNT_NUMBER=your_escrow_account_number
ESCROW_BANK_NAME=your_bank_name
ESCROW_IFSC=your_ifsc_code

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@lunara.com

# SMS Configuration (Optional - for OTP)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=LUNARA

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Session Configuration
SESSION_SECRET=your_session_secret_change_in_production

# Admin Panel URL
ADMIN_PANEL_URL=http://localhost:5173

# Mobile App URLs
ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.lunara
IOS_APP_URL=https://apps.apple.com/app/lunara

# Compliance & Security
ENABLE_DPDP_COMPLIANCE=true
AGE_VERIFICATION_REQUIRED=true
MINIMUM_AGE=18
CONTENT_MODERATION_ENABLED=true

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_KEY=your_analytics_key

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:5173
