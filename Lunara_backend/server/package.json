{
  "name": "lunara-backend",
  "version": "1.0.0",
  "description": "Backend API for Lunara - Nightlife Discovery & Booking Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:inspect": "nodemon --inspect=0.0.0.0:9229",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:inspect": "node --inspect=0.0.0.0:9229 dist/server.js",
    "profile:doctor": "npx clinic doctor -- node dist/server.js",
    "profile:flame": "npx clinic flame -- node dist/server.js",
    "profile:bubble": "npx clinic bubbleprof -- node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "db:init": "ts-node src/initDatabase.ts"
  },
  "keywords": [
    "nightlife",
    "booking",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@google-cloud/vision": "^5.3.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-azure-blob-storage": "^1.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "sequelize": "^6.35.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.6.1",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.22",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.63.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
